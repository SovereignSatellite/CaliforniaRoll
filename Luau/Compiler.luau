const stack_pool: { [number]: { { any } } } = {
	[16] = {},
	[64] = {},
	[256] = {},
	[1024] = {},
	[4096] = {},
	[16384] = {},
}

const function stack_acquire(size_class: number): { any }
	const stack = table.remove(stack_pool[size_class])

	return if stack == nil then table.create(size_class) else stack
end

const function stack_release(stack: { any }, size_class: number)
	table.insert(stack_pool[size_class], stack)
end

