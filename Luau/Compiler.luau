type Array<T> = { [number]: T, length: number }

const function array_new<T>(length: number, value: T): Array<T>?
	const created, result = pcall(table.create, length, value)

	if not created then
		return nil
	end

	const array: any = result
	array.length = length

	return array
end

const buffer_create = buffer.create

const buffer_fill = buffer.fill

const function array_new_i8(length: number, value: number): buffer?
	const created, array = pcall(buffer_create, length)

	if not created then
		return nil
	end

	buffer_fill(array, 0, value)

	return array
end

