				buffer.writeu32(bytes, exception - DESTRUCTOR, destructor)
				call("__cxa_increment_exception_refcount", exception)
				thrown = exception
				error(CPP_EXCEPTION, 0)
			end,
			__resumeException = function(_, exception)
				thrown = thrown or exception
				error(CPP_EXCEPTION, 0)
			end,
			__cxa_begin_catch = function(_, exception)
				const bytes = readMemory()
				buffer.writeu8(bytes, exception - CAUGHT, 1)
				buffer.writeu8(bytes, exception - RETHROWN, 0)
				table.insert(caught, exception)
				return (call("__cxa_get_exception_ptr", exception))
			end,
			__cxa_end_catch = function()
				call("setThrew", 0, 0)
				call("__cxa_decrement_exception_refcount", (table.remove(caught)))
				thrown = nil
			end,
			__cxa_find_matching_catch_2 = findMatchingCatch,
			__cxa_find_matching_catch_3 = findMatchingCatch,
			__cxa_find_matching_catch_4 = findMatchingCatch,
			llvm_eh_typeid_for = function(_, kind)
				return kind
			end,
			emscripten_date_now = dateNow,
			emscripten_get_now = performanceNow,
		}

		for _, signature in INVOKES do
			env[`invoke_{signature}`] = invoke
		end

		for _, name in { "_gmtime_js", "_localtime_js" } do
			env[name] = function()
				error(`unimplemented: env.{name}`, 0)
			end
		end

		const wasi = {
			-- Emscripten reads the CPU-time clocks, 2 and 3, as the monotonic one.
			clock_time_get = function(_, clock, _precision, destination)
				if clock > 3 then
					return EINVAL
				end

				const nanoseconds = math.round((if clock == 0 then dateNow() else performanceNow()) * 1e6)
				const bytes = readMemory()
				buffer.writeu32(bytes, destination, nanoseconds % 2 ^ 32)
				buffer.writeu32(bytes, destination + 4, nanoseconds // 2 ^ 32)
				return 0
			end,
			fd_write = function(_, descriptor, vectors, count, written)
				const bytes = readMemory()
				const line = pending[descriptor]
				local total = 0

				for vector = vectors, vectors + (count - 1) * 8, 8 do
					const length = buffer.readu32(bytes, vector + 4)
					const text = buffer.readstring(bytes, buffer.readu32(bytes, vector), length)
					local start = 1

					for ending in string.gmatch(text, "()[\n%z]") do
						table.insert(line, (string.sub(text, start, ending - 1)))
						print((table.concat(line)))
						table.clear(line)
						start = ending + 1
					end

					table.insert(line, (string.sub(text, start)))
					total += length
				end

				buffer.writeu32(bytes, written, total)
				return 0
			end,
		}

		const imports = { env = env, wasi_snapshot_preview1 = wasi }

		for _, namespace in imports do
			for name, body in namespace do
				namespace[name] = closure(body)
			end
		end

		return { imports = imports, call = exported, memory = readMemory, owned = owned, allocated = allocated }
	end

	const exports = module.exports

	const host = createHost(function()
		return exports.memory[1][1]
	end, function(name, first, second, third, fourth, fifth)
		const callee = exports[name]
		return (callee[1](callee[2], first, second, third, fourth, fifth))
	end, function(index, first, second, third, fourth, fifth, sixth, seventh, eighth, ninth, tenth, eleventh, twelfth)
		const contents = exports.__indirect_function_table[1]
		return (
			contents[2][index + 1](
				contents[3][index + 1],
				first,
				second,
				third,
				fourth,
				fifth,
				sixth,
				seventh,
				eighth,
				ninth,
				tenth,
				eleventh,
				twelfth
			)
		)
	end, function(body)
		return { body, {} }
	end)

	for name, namespace in host.imports do
		module.imports[name] = namespace
	end

	module.start()
	host.call("__wasm_call_ctors")

	const TOP = 2 ^ 32 - 1
	const YIELD = 1
	const CHUNK = "=bytecode\0"

	const function message(thread: number): string
		return (
			host.allocated(4, function(length)
				const text = host.call("lua_tolstring", thread, TOP, length) :: number
				return if text == 0
					then ""
					else buffer.readstring(host.memory(), text, (buffer.readu32(host.memory(), length)))
			end)
		)
	end

	const function loaded(thread: number, bytecode: buffer): boolean
		const size = buffer.len(bytecode)

		return (
			host.allocated(#CHUNK + size, function(chunk)
				buffer.writestring(host.memory(), chunk, CHUNK)
				buffer.copy(host.memory(), chunk + #CHUNK, bytecode)
				return host.call("luau_load", thread, chunk, chunk + #CHUNK, size, 0) == 0
			end)
		)
	end

	const function failure(thread: number, bytecode: buffer): string?
		if not loaded(thread, bytecode) then
			return (message(thread))
		end

		const status = host.call("lua_resume", thread, 0, 0) :: number

		if status == 0 then
			return nil
		end

		const text = if status == YIELD then "thread yielded unexpectedly" else message(thread)
		return `{text}\nstack backtrace:\n{readString(host.memory(), host.call("lua_debugtrace", thread) :: number)}`
	end

	const function load(bytecode: buffer): () -> ()
		return function()
			const state = host.call("luaL_newstate") :: number

			if state == 0 then
				error("not enough memory", 0)
			end

			const text = host.owned(state, "lua_close", function()
				host.call("luaL_openlibs", state)
				return (failure(host.call("lua_newthread", state) :: number, bytecode))
			end)

			if text then
				error(text, 0)
			end
		end
	end

	return { load = load }
end
