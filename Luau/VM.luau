const function i64_division_u(
	low: number,
	high: number,
	divisor_low: number,
	divisor_high: number
): (number, number, number, number)
	if high < 0x20_0000 and divisor_high < 0x20_0000 then
		const value = low + high * 0x1_0000_0000
		const divisor = divisor_low + divisor_high * 0x1_0000_0000
		const quotient = value // divisor
		const remainder = value - quotient * divisor

		return quotient % 0x1_0000_0000,
			quotient // 0x1_0000_0000,
			remainder % 0x1_0000_0000,
			remainder // 0x1_0000_0000
	end

	const value_zeros = if high == 0 then 32 + bit32_countlz(low) else bit32_countlz(high)
	const divisor_zeros = if divisor_high == 0 then 32 + bit32_countlz(divisor_low) else bit32_countlz(divisor_high)
	const shift = divisor_zeros - value_zeros

	if shift < 0 then
		return 0, 0, low, high
	end

	local shifted_low = if shift >= 32 then 0 else bit32_lshift(divisor_low, shift)
	local shifted_high = if shift >= 32
		then bit32_lshift(divisor_low, shift - 32)
		else bit32_or(bit32_lshift(divisor_high, shift), (bit32_rshift(bit32_rshift(divisor_low, 1), 31 - shift)))
	local quotient_low, quotient_high = 0, 0
	local remainder_low, remainder_high = low, high

	for offset = shift, 0, -1 do
		if remainder_high > shifted_high or (remainder_high == shifted_high and remainder_low >= shifted_low) then
			remainder_low -= shifted_low
			remainder_high -= shifted_high

			if remainder_low < 0 then
				remainder_low += 0x1_0000_0000
				remainder_high -= 1
			end

			if offset >= 32 then
				quotient_high = bit32_or(quotient_high, (bit32_lshift(1, offset - 32)))
			else
				quotient_low = bit32_or(quotient_low, (bit32_lshift(1, offset)))
			end
		end

		shifted_low = bit32_or(bit32_rshift(shifted_low, 1), (bit32_lshift(shifted_high, 31)))
		shifted_high = bit32_rshift(shifted_high, 1)
	end

	return quotient_low, quotient_high, remainder_low, remainder_high
end

const function i64_negate_words(low: number, high: number): (number, number)
	if low == 0 then
		return 0, (0x1_0000_0000 - high) % 0x1_0000_0000
	end

	return 0x1_0000_0000 - low, 0xFFFF_FFFF - high
end

const function i64_divide_s(lhs: number, rhs: number): number
	local low, high = bits_from_i64(lhs)
	local divisor_low, divisor_high = bits_from_i64(rhs)
	const negative = high >= 0x8000_0000
	const divisor_negative = divisor_high >= 0x8000_0000

	if negative then
		low, high = i64_negate_words(low, high)
	end

	if divisor_negative then
		divisor_low, divisor_high = i64_negate_words(divisor_low, divisor_high)
	end

	local quotient_low, quotient_high = i64_division_u(low, high, divisor_low, divisor_high)

	if negative ~= divisor_negative then
		quotient_low, quotient_high = i64_negate_words(quotient_low, quotient_high)
	end

	return (bits_into_i64(quotient_low, quotient_high))
end

const function i64_divide_u(lhs: number, rhs: number): number
	const low, high = bits_from_i64(lhs)
	const divisor_low, divisor_high = bits_from_i64(rhs)
	const quotient_low, quotient_high = i64_division_u(low, high, divisor_low, divisor_high)

	return (bits_into_i64(quotient_low, quotient_high))
end

const function i64_remainder_s(lhs: number, rhs: number): number
	local low, high = bits_from_i64(lhs)
	local divisor_low, divisor_high = bits_from_i64(rhs)
	const negative = high >= 0x8000_0000

	if negative then
		low, high = i64_negate_words(low, high)
	end

	if divisor_high >= 0x8000_0000 then
		divisor_low, divisor_high = i64_negate_words(divisor_low, divisor_high)
	end

	local _, _, remainder_low, remainder_high = i64_division_u(low, high, divisor_low, divisor_high)

	if negative then
		remainder_low, remainder_high = i64_negate_words(remainder_low, remainder_high)
	end

	return (bits_into_i64(remainder_low, remainder_high))
end

const function i64_remainder_u(lhs: number, rhs: number): number
	const low, high = bits_from_i64(lhs)
	const divisor_low, divisor_high = bits_from_i64(rhs)
	const _, _, remainder_low, remainder_high = i64_division_u(low, high, divisor_low, divisor_high)

	return (bits_into_i64(remainder_low, remainder_high))
end

